<%
/*
  Optimum / PrimeBridge icon set (our own drawings) — copied from prime-login and
  extended with energy icons for the solar dashboard.
  Rules: 24×24 grid, 2px safe margin, 1.75 stroke, square line caps, mitred corners.
  Signal icons pair a SHAPE with a colour so meaning never relies on colour alone:
    signal-ok circle (green) · signal-info circle (lime) · signal-warning rhombus (yellow) · signal-error triangle (red)
  Usage: include("partials/icon.ejs", { name: "sun" })
*/
const stroke = 'fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"';
const icons = {
  "arrow-right": `<path d="M4 12 H19" ${stroke} stroke-width="2.2"/><path d="M13 6 L19 12 L13 18" ${stroke} stroke-width="2.2"/>`,
  "external": `<path d="M14 4 H20 V10" ${stroke}/><path d="M20 4 L11 13" ${stroke}/><path d="M18 14 V20 H4 V6 H10" ${stroke}/>`,
  "close": `<path d="M6 6 L18 18 M18 6 L6 18" ${stroke}/>`,
  "chevron-down": `<path d="M6 9 L12 15 L18 9" ${stroke}/>`,
  "bell": `<path d="M6 17 V11 L8 6 H16 L18 11 V17" ${stroke}/><path d="M4 17 H20" ${stroke}/><path d="M10 20.5 H14" ${stroke}/>`,
  "list": `<path d="M4 6 H20 M4 12 H20 M4 18 H14" ${stroke}/>`,
  "sun": `<path d="M12 8 L16 12 L12 16 L8 12 Z" ${stroke}/><path d="M12 2.5 V5 M12 19 V21.5 M2.5 12 H5 M19 12 H21.5 M5.3 5.3 L7 7 M17 17 L18.7 18.7 M18.7 5.3 L17 7 M7 17 L5.3 18.7" ${stroke}/>`,
  "grid": `<path d="M7.5 21.5 L12 2.5 L16.5 21.5" ${stroke}/><path d="M5 7.5 H19 M7 13 H17 M9.2 13 L15.6 21.5 M14.8 13 L8.4 21.5" ${stroke}/>`,
