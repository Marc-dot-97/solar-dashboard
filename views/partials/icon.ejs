  "signal-info": `<circle cx="12" cy="12" r="9" fill="#9BC53D"/><path d="M12 11 V17 M12 7 V8.5" fill="none" stroke="#2E3236" stroke-width="2.2" stroke-linecap="square"/>`,
  "signal-warning": `<path d="M12 2 L22 12 L12 22 L2 12 Z" fill="#F5C842"/><path d="M12 7 V13 M12 16 V17.5" fill="none" stroke="#2E3236" stroke-width="2.2" stroke-linecap="square"/>`,
