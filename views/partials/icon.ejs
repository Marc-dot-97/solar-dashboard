  "home": `<path d="M3 11 L12 3 L21 11" ${stroke}/><path d="M5.5 9 V21 H18.5 V9" ${stroke}/><path d="M10 21 V15 H14 V21" ${stroke}/>`,
  "building": `<path d="M5 3 H19 V21 H5 Z" ${stroke}/><path d="M9 7 H10.5 M13.5 7 H15 M9 11 H10.5 M13.5 11 H15 M9 15 H10.5 M13.5 15 H15" ${stroke}/><path d="M10.5 21 V18 H13.5 V21" ${stroke}/>`,
