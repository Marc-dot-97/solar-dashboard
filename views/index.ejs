<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= siteName %> · Solar</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="top">
    <div>
      <h1><%= siteName %></h1>
      <p class="sub">VRM installation <%= siteId %> · refreshes every <%= refreshSeconds %>s</p>
    </div>
    <div class="status" id="status"><span class="dot"></span><span id="statusText">Connecting…</span></div>
  </header>

  <main>
    <div class="banner hidden" id="banner"></div>

    <!-- Headline tiles -->
    <section class="tiles">
      <article class="tile solar">
        <h2>Solar</h2>
        <div class="big" id="solarTotal">–</div>
        <div class="meta">Today: <b id="solarYield">–</b></div>
        <ul class="split" id="solarSplit"></ul>
      </article>

      <article class="tile battery">
        <h2>Battery</h2>
        <div class="big" id="batterySoc">–</div>
        <div class="soc-bar"><div id="socFill"></div></div>
        <div class="meta" id="batteryFlow">–</div>
        <ul class="split">
          <li><span>Voltage</span><b id="batteryV">–</b></li>
          <li><span>Current</span><b id="batteryA">–</b></li>
          <li><span>State</span><b id="batteryState">–</b></li>
          <li><span>Health</span><b id="batteryHealth">–</b></li>
          <li><span>Temperature</span><b id="batteryTemp">–</b></li>
        </ul>
      </article>

      <article class="tile grid">
        <h2>Grid</h2>
        <div class="big" id="gridTotal">–</div>
        <div class="meta" id="gridFlow">–</div>
        <ul class="split" id="gridSplit"></ul>
      </article>

      <article class="tile load">
        <h2>Consumption</h2>
        <div class="big" id="loadTotal">–</div>
        <div class="meta">Inverter: <b id="inverterState">–</b></div>
        <ul class="split" id="loadSplit"></ul>
      </article>
    </section>

    <% if (historyEnabled) { %>
    <section class="panel">
      <div class="panel-head">
        <h2>Last 24 hours</h2>
        <span class="hint">Saved to MySQL every minute</span>
      </div>
      <div class="chart-box"><canvas id="historyChart"></canvas></div>
    </section>
    <% } %>

    <section class="panel">
      <details>
        <summary>All device values from VRM</summary>
        <div id="devices" class="devices"></div>
      </details>
    </section>
  </main>

  <footer>Last VRM reading: <span id="lastReading">–</span></footer>

  <script>
    window.DASHBOARD = { refreshSeconds: <%= refreshSeconds %>, historyEnabled: <%= historyEnabled %> };
  </script>
  <% if (historyEnabled) { %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <% } %>
  <script src="/app.js"></script>
</body>
</html>
