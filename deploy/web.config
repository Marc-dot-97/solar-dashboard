<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS front door for Solar View (solar-view.primebridge.co.za).
  IIS keeps the HTTPS certificate; every request is passed to the Node app on 127.0.0.1:3020.
  Needs the IIS "URL Rewrite" and "Application Request Routing" modules (iis-setup.ps1 checks).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Always use HTTPS -->
        <rule name="Solar View HTTPS only" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Everything else goes to the Node app -->
        <rule name="Solar View to Node" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3020/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Show the app's own error pages instead of IIS ones -->
    <httpErrors existingResponse="PassThrough" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
    <security>
      <!-- Hide the "Server: Microsoft-IIS" header (IIS 10 / Windows Server 2016+) -->
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
</configuration>
