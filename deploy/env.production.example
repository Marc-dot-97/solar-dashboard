# Solar View - PRODUCTION settings (10.10.1.2)
# The installer copies this to C:\Apps\solar-dashboard\.env the first time.
# Fill in every value that is wrapped in double angle brackets, save, then run install.ps1 again.

NODE_ENV=production
PORT=3020
# Only IIS on this same server may talk to the app directly:
HOST=127.0.0.1

SITE_NAME=Optimum Financial Services Group
SITE_ADDRESS=Route 21 Corporate Park, 56 Regency Dr, Irene, Pretoria, 0157
SITE_ADDRESS_SHORT=Route 21 Corporate Park, Irene
BROWSER_REFRESH_SECONDS=15
POLL_SECONDS=60

# --- Victron VRM ---
VRM_SITES=329491=Pentagon Partners;327307=Westside Tradings
# A NEW token made for PROD: VRM -> Preferences -> Integrations -> Access tokens -> Add (name it "solar-view PROD").
VRM_TOKEN=<<PASTE_THE_PROD_VRM_TOKEN>>

# --- MySQL on this server (the 26.7 instance on port 3306) ---
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=solar_app
DB_PASSWORD=<<THE_PROD_PASSWORD_FOR_SOLAR_APP>>
DB_NAME=solar_dashboard
