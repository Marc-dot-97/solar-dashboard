# Copy this file to ".env" and fill in the values.
# NEVER commit .env to GitHub - it is already listed in .gitignore.

# ---- Web server ----
PORT=3000
SITE_NAME=Optimum Financial Services Group
SITE_ADDRESS=Route 21 Corporate Park, 56 Regency Dr, Irene, Pretoria, 0157
SITE_ADDRESS_SHORT=Route 21 Corporate Park, Irene
# How often the browser refreshes the numbers (seconds)
BROWSER_REFRESH_SECONDS=15
# How often the server asks VRM for new data (seconds, minimum 30).
# Your Cerbo GX logs to VRM every 1 minute, so 60 is the sweet spot.
POLL_SECONDS=60

# ---- Victron VRM API ----
# Installation ID = the number in https://vrm.victronenergy.com/installation/329491/dashboard
VRM_SITE_ID=329491
# VRM -> Preferences -> Integrations -> Access tokens -> Add  (paste the token here)
VRM_TOKEN=

# ---- MySQL (DEV server) ----
# Set DB_ENABLED=false to run the live dashboard without a database.
DB_ENABLED=true
DB_HOST=
DB_PORT=3306
DB_USER=solar_app
DB_PASSWORD=
DB_NAME=solar_dashboard
